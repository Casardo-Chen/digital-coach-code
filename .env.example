# Copy to .env. Do not commit .env.

# LLM calls (annotation, CLAIR, ablation, and the realtime coach) use OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_VLM_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=Digital Coach

# Sessions load from Hugging Face. Override the dataset id, or add a token if it is gated.
# DIGITAL_COACH_DATASET=berkeley-hci/digital-coach
# HF_TOKEN=

# Realtime prototype (GetStream + speech). Not used by annotation or CLAIR.
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_TIMEOUT=30
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8000
